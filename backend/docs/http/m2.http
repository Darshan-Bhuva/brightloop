@baseUrl = http://localhost:8000/api
@adminToken = paste-admin-access-token-here
@staffToken = paste-staff-access-token-here

### TAX-01 List taxes (Admin / Staff)
GET {{baseUrl}}/taxes?search=GST&is_active=true&all=1
Accept: application/json
Authorization: Bearer {{staffToken}}

### TAX-02 Create tax (Admin only)
POST {{baseUrl}}/taxes
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "GST 28%",
  "type": "percentage",
  "rate": 28.00,
  "is_active": true
}

### TAX-03 Update tax (Admin only)
PUT {{baseUrl}}/taxes/1
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "GST 5% Updated",
  "type": "percentage",
  "rate": 5.50,
  "is_active": true
}

### TAX-04 Delete tax (Admin only)
DELETE {{baseUrl}}/taxes/1
Accept: application/json
Authorization: Bearer {{adminToken}}


### PT-01 List payment terms (Admin / Staff)
GET {{baseUrl}}/payment-terms?all=1
Accept: application/json
Authorization: Bearer {{staffToken}}

### PT-02 Create payment term (Admin only)
POST {{baseUrl}}/payment-terms
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Net 60",
  "due_days": 60
}

### PT-03 Update payment term (Admin only)
PUT {{baseUrl}}/payment-terms/1
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Immediate Updated",
  "due_days": 0
}

### PT-04 Delete payment term (Admin only)
DELETE {{baseUrl}}/payment-terms/1
Accept: application/json
Authorization: Bearer {{adminToken}}


### PRD-01 List products (Admin / Staff)
GET {{baseUrl}}/products?type=service&is_active=true&sort=sales_price&direction=desc&page=1&per_page=15
Accept: application/json
Authorization: Bearer {{staffToken}}

### PRD-02 Create product (Admin only)
POST {{baseUrl}}/products
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Brightloop Enterprise Suite",
  "type": "service",
  "sales_price": 5000.00,
  "cost_price": 2000.00,
  "tax_id": 1,
  "notes": "Enterprise business management suite",
  "is_active": true,
  "variants": [
    {
      "attribute": "Tier",
      "value": "Gold",
      "extra_price": 750.00
    },
    {
      "attribute": "Tier",
      "value": "Platinum",
      "extra_price": 1500.00
    }
  ]
}

### PRD-03 Show product (Admin / Staff)
GET {{baseUrl}}/products/1
Accept: application/json
Authorization: Bearer {{staffToken}}

### PRD-04 Update product (Admin only)
PUT {{baseUrl}}/products/1
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Brightloop Business Suite",
  "type": "service",
  "sales_price": 4200.00,
  "cost_price": 1600.00,
  "tax_id": 1,
  "notes": "Updated notes",
  "is_active": true,
  "variants": [
    {
      "id": 1,
      "attribute": "Brand",
      "value": "Odoo Updated",
      "extra_price": 600.00
    },
    {
      "attribute": "Brand",
      "value": "Enterprise New",
      "extra_price": 800.00
    }
  ]
}

### PRD-05 Delete product (Admin only)
DELETE {{baseUrl}}/products/1
Accept: application/json
Authorization: Bearer {{adminToken}}
